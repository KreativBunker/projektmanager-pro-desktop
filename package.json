{
  "name": "projektmanager-pro",
  "version": "1.6.3",
  "description": "ProjektManager Pro – Desktop App",
  "homepage": "https://github.com/KreativBunker/projektmanager-pro-desktop",
  "author": {
    "name": "KreativBunker",
    "email": "info@kreativbunker.de"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
