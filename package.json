    "build:all": "electron-builder -mwl",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "extends": "file:./electron-builder.config.js"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
